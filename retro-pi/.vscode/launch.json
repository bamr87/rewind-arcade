{
  // retro-pi debug configurations.
  //
  // The Python entries work as soon as the Python extension is installed.
  //
  // The bash entries need the "Bash Debug" extension (rogalmic.bash-debug)
  // AND bash 4+. macOS ships bash 3.2 (2007), which the debugger cannot
  // drive, so on a Mac:      brew install bash
  //
  // "pathBash": "bash" resolves through PATH deliberately, rather than
  // hardcoding a path: Homebrew installs to /opt/homebrew/bin on Apple
  // Silicon but /usr/local/bin on Intel, and Linux/Raspberry Pi already has
  // a modern bash at /bin/bash. Check what you will get with:
  //     bash -c 'echo $BASH_VERSION'
  // If that still prints 3.2, put the absolute path to a newer bash here.
  //
  // IMPORTANT: retro-pi is written to RUN on bash 3.2, but you will be
  // DEBUGGING under bash 5. Behaviour differs between them (empty arrays
  // under `set -u`, `&` in ${var//pat/repl}), so a bug that only appears on
  // stock macOS can vanish while you step through it. Confirm fixes with
  // `./tests/run.sh` under /bin/bash, and `make test-linux` for the Pi.
  "version": "0.2.0",
  "configurations": [
    // ----------------------------------------------------------- Python ----
    {
      "name": "Python: parse a system manifest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/yamlite.py",
      "args": ["json", "${workspaceFolder}/config/systems/${input:systemId}.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Same manifest, forced through the built-in parser: this is the code
      // path a stock Raspberry Pi takes, where PyYAML is not installed.
      "name": "Python: parse a manifest (built-in parser / Pi path)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/yamlite.py",
      "args": ["json", "${workspaceFolder}/config/systems/${input:systemId}.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "RETROPI_YAML_PURE": "1" }
    },
    {
      "name": "Python: flatten the merged config",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/yamlite.py",
      "args": ["flat", "${workspaceFolder}/config/retropi.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: generate the NES test ROM",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/fixtures/make_test_rom.py",
      "args": ["${workspaceFolder}/roms/nes/retropi-test.nes"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ------------------------------------------------------------- bash ----
    {
      "name": "retropi: doctor",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/retropi",
      "args": ["doctor", "--verbose"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated",
      "showDebugOutput": true
    },
    {
      "name": "retropi: build (no install)",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/retropi",
      // --no-install keeps the debugger from touching your real frontend config.
      "args": ["build", "--no-install", "--systems", "${input:systemId}"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated",
      "showDebugOutput": true
    },
    {
      "name": "retropi: systems show",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/retropi",
      "args": ["systems", "show", "${input:systemId}"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    },
    {
      "name": "retropi: cores list",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/retropi",
      "args": ["cores", "list"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    },
    {
      "name": "retropi: roms scan",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/retropi",
      "args": ["roms", "scan"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    },
    {
      "name": "Run: launch a ROM (windowed)",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run-rom.sh",
      "args": ["${input:systemId}"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    },
    {
      "name": "Tests: one file",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/tests/run.sh",
      "args": ["${input:testFile}", "-v"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    },
    {
      "name": "Tests: whole suite",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/tests/run.sh",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "pathBash": "bash",
      "terminalKind": "integrated"
    }
  ],

  "inputs": [
    {
      "id": "systemId",
      "type": "pickString",
      "description": "Which system?",
      "default": "nes",
      "options": [
        "nes", "snes", "n64", "gb", "gbc", "gba", "nds",
        "megadrive", "mastersystem", "gamegear", "segacd", "sega32x",
        "saturn", "dreamcast", "psx", "psp",
        "atari2600", "atari7800", "pcengine", "neogeo", "arcade", "dos", "c64"
      ]
    },
    {
      "id": "testFile",
      "type": "pickString",
      "description": "Which test file?",
      "default": "yamlite",
      "options": [
        "yamlite", "config", "systems", "build", "cli", "manifests", "fixtures"
      ]
    }
  ]
}
