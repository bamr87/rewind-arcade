{
  // Run-only workflows. Debugging lives in launch.json.
  // Ctrl/Cmd+Shift+B runs the default build task ("check").
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "detail": "shellcheck + config validation + the full test suite",
      "type": "shell",
      "command": "make check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "test",
      "detail": "Run the test suite",
      "type": "shell",
      "command": "./tests/run.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "test (verbose)",
      "type": "shell",
      "command": "./tests/run.sh -v",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "test: built-in YAML parser (Pi path)",
      "detail": "Forces the parser a stock Raspberry Pi uses",
      "type": "shell",
      "command": "RETROPI_YAML_PURE=1 ./tests/run.sh",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "test: Linux container (Raspberry Pi code path)",
      "detail": "bash 5.x on Debian with no PyYAML - needs Docker",
      "type": "shell",
      "command": "make test-linux",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "doctor",
      "detail": "Check this machine and report what is missing",
      "type": "shell",
      "command": "./bin/retropi doctor",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "build",
      "detail": "Regenerate frontend + emulator configuration",
      "type": "shell",
      "command": "./bin/retropi build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "build (no install)",
      "detail": "Generate into build/ without touching your frontend",
      "type": "shell",
      "command": "./bin/retropi build --no-install",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "cores: install for enabled systems",
      "type": "shell",
      "command": "./bin/retropi cores install",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "generate NES test ROM",
      "detail": "An original test cartridge - no game required",
      "type": "shell",
      "command": "mkdir -p roms/nes && python3 tests/fixtures/make_test_rom.py roms/nes/retropi-test.nes",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "run: NES test ROM",
      "detail": "Generate the test cartridge and launch it windowed",
      "type": "shell",
      "command": "./tools/run-rom.sh nes roms/nes/retropi-test.nes --log /tmp/retroarch.log",
      "dependsOn": "generate NES test ROM",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "run: print launch command",
      "detail": "Show what the frontend will execute, run nothing",
      "type": "shell",
      "command": "./tools/run-rom.sh ${input:systemId} --print",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    // ------------------------------------------- dev harness + ML ----
    // Every `retropi dev` / `ml` command re-runs itself on the host when VS
    // Code is a Flatpak (SteamOS), so these work from the sandbox.
    {
      "label": "dev: run a game (live harness)",
      "detail": "RetroArch windowed, command port + Network RetroPad open; drive it with dev peek/press/step",
      "type": "shell",
      "command": "./bin/retropi dev run ${input:systemId} ${input:romPath}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev: run the open ROM",
      "detail": "The ROM file open in the editor, system from its folder or extension",
      "type": "shell",
      "command": "./bin/retropi dev run \"${file}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev: frontend (ES-DE, debug log)",
      "type": "shell",
      "command": "./bin/retropi dev frontend",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev: logs",
      "detail": "Follow build/dev/retroarch.log and ES-DE's es_log.txt",
      "type": "shell",
      "command": "./bin/retropi dev logs",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "dev: REPL against the running game",
      "type": "shell",
      "command": "./bin/retropi dev repl",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    },
    {
      "label": "dev: check",
      "type": "shell",
      "command": "./bin/retropi dev check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ml: check smb-1-1",
      "detail": "Gymnasium API check, random rollout, emulator speed",
      "type": "shell",
      "command": "./bin/retropi ml check smb-1-1",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ml: train smb-1-1",
      "detail": "PPO, 16 parallel emulators; runs land in packages/ml/runs/",
      "type": "shell",
      "command": "./bin/retropi ml train --game smb-1-1 --envs 16",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ml: random baseline smb-1-1",
      "type": "shell",
      "command": "./bin/retropi ml eval --random --episodes 100",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ml: tensorboard",
      "type": "shell",
      "command": "./bin/retropi ml board",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "./bin/retropi clean",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "systemId",
      "type": "pickString",
      "description": "Which system?",
      "default": "nes",
      "options": [
        "nes", "snes", "n64", "gb", "gbc", "gba", "nds",
        "megadrive", "mastersystem", "gamegear", "segacd", "sega32x",
        "saturn", "dreamcast", "psx", "psp",
        "atari2600", "atari7800", "pcengine", "neogeo", "arcade", "dos", "c64"
      ]
    },
    {
      "id": "romPath",
      "type": "promptString",
      "description": "ROM path (empty: the system's first ROM)",
      "default": ""
    }
  ]
}
