# .env.example — every environment variable rewind-arcade reads (UPS-REPO-32).
# All are optional; leave them unset to use the defaults. Names only: never
# commit real values (copy to .env, which is gitignored).

# arcade/vite.config.ts — folder of ROM dumps the dev server lists at
# /roms-index.json (default: emulate/roms). ARCADE_ROMS wins over RETROPI_PATHS_ROMS.
ARCADE_ROMS=
RETROPI_PATHS_ROMS=

# arcade/vite.config.ts — folder holding a vendored EmulatorJS build
# (default: arcade/vendor/emulatorjs).
ARCADE_EMULATORJS=

# catalog/src/cartridge_index/config.py — path to the cartidx config file
# (default: the search order documented in catalog/README.md).
CARTIDX_CONFIG=

# emulate/lib/yamlite.py — set to 1 to force the built-in YAML parser.
RETROPI_YAML_PURE=
