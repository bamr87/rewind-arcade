# ---- OS / editor -------------------------------------------------------------
.DS_Store
._*
Thumbs.db
*.swp
.idea/

# ---- Arcade (browser games) --------------------------------------------------
arcade/node_modules/
arcade/dist/
arcade/*.tsbuildinfo
**/.vite
*.local
.playwright-mcp

# ---- Emulate (never commit game data) ----------------------------------------
emulate/roms/**
!emulate/roms/.gitkeep
!emulate/roms/README.md
emulate/bios/**
!emulate/bios/.gitkeep
!emulate/bios/README.md
emulate/saves/**
!emulate/saves/.gitkeep
emulate/screenshots/**
!emulate/screenshots/.gitkeep
emulate/themes/**
!emulate/themes/.gitkeep
emulate/downloads/
emulate/media/
emulate/.retropi/
emulate/build/
emulate/dist/
emulate/config/local.yaml
emulate/config/*.local.yaml
emulate/.vscode/*
!emulate/.vscode/extensions.json
!emulate/.vscode/launch.json
!emulate/.vscode/tasks.json
!emulate/.vscode/settings.json

# ---- Catalog (never commit dumps or personal data) ---------------------------
catalog/cartridge.toml
catalog/collection/
catalog/workspace/
catalog/data/reference/
catalog/*.egg-info/
catalog/build/
catalog/dist/

